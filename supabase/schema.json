      "functions": [
        {
          "name": "update_last_active_at",
          "security_definer": false,
          "definition": "CREATE OR REPLACE FUNCTION public.update_last_active_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  if TG_TABLE_NAME = 'notices' then\r\n    new.last_active_at = timezone('utc'::text, now());\r\n    return new;\r\n  elsif TG_TABLE_NAME = 'tasks' then\r\n    update notices set last_active_at = timezone('utc'::text, now()) where id = new.notice_id;\r\n    return new;\r\n  end if;\r\nend;\r\n$function$\n"
        },
        {
          "name": "get_current_user_role",
          "security_definer": true,
          "definition": "CREATE OR REPLACE FUNCTION public.get_current_user_role()\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT role::text FROM public.profiles WHERE id = auth.uid();\r\n$function$\n"
        },
        {
          "name": "create_audit_log",
          "security_definer": false,
          "definition": "CREATE OR REPLACE FUNCTION public.create_audit_log()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\ndeclare\r\n  log_hash text;\r\n  action_type text;\r\n  target_notice_id uuid;\r\nbegin\r\n  if TG_OP = 'INSERT' then\r\n    action_type = 'CREATE';\r\n  else\r\n    action_type = 'UPDATE';\r\n  end if;\r\n\r\n  if TG_TABLE_NAME = 'notices' then\r\n    target_notice_id = coalesce(new.id, old.id);\r\n  else\r\n    target_notice_id = coalesce(new.notice_id, old.notice_id);\r\n  end if;\r\n\r\n  -- Tamper evident hash\r\n  log_hash = encode(digest(TG_TABLE_NAME || TG_OP || target_notice_id::text || now()::text, 'sha256'), 'hex');\r\n\r\n  insert into audit_logs (notice_id, action_type, actor_id, changes, hash)\r\n  values (target_notice_id, action_type || '_' || TG_TABLE_NAME, auth.uid(), row_to_json(new), log_hash);\r\n  \r\n  return new;\r\nend;\r\n$function$\n"
        },
        {
          "name": "assign_ca_to_business",
          "security_definer": true,
          "definition": "CREATE OR REPLACE FUNCTION public.assign_ca_to_business(p_business_id uuid, p_ca_email text)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\r\nDECLARE\r\n  v_ca_profile RECORD;\r\nBEGIN\r\n  SELECT id, email, role, full_name\r\n  INTO v_ca_profile\r\n  FROM public.profiles\r\n  WHERE LOWER(TRIM(email)) = LOWER(TRIM(p_ca_email))\r\n  LIMIT 1;\r\n\r\n  IF NOT FOUND THEN\r\n    RETURN jsonb_build_object(\r\n      'success', false,\r\n      'error', 'No registered account found with email \"' || p_ca_email || '\". The CA must create an account on VyapaarSathi first.'\r\n    );\r\n  END IF;\r\n\r\n  IF v_ca_profile.role <> 'ca' THEN\r\n    RETURN jsonb_build_object(\r\n      'success', false,\r\n      'error', 'The account \"' || p_ca_email || '\" is registered as a Business Owner, not a Chartered Accountant.'\r\n    );\r\n  END IF;\r\n\r\n  UPDATE public.businesses\r\n  SET ca_id = v_ca_profile.id\r\n  WHERE id = p_business_id;\r\n\r\n  RETURN jsonb_build_object(\r\n    'success', true,\r\n    'ca_id', v_ca_profile.id,\r\n    'email', v_ca_profile.email,\r\n    'full_name', v_ca_profile.full_name\r\n  );\r\nEND;\r\n$function$\n"
        },
        {
          "name": "get_current_user_business_id",
          "security_definer": true,
          "definition": "CREATE OR REPLACE FUNCTION public.get_current_user_business_id()\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  SELECT business_id FROM public.profiles WHERE id = auth.uid();\r\n$function$\n"
        }
